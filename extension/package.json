{
  "name": "bookmark-mcp-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Captures the posts you save on X (bookmarks, folders, likes) and sends them to your local bookmark-mcp app.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
